PROJECT_NAME=UN-DICAM Backend
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://undicam:undicam@db:5432/undicam
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
STORAGE_DIR=storage
# Cambia este valor: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esta-clave-por-una-aleatoria-de-64-caracteres-hex
ACCESS_TOKEN_EXPIRE_MINUTES=720
MAX_UPLOAD_MB=500
# Opcional: commit del codigo para los metadatos de reproducibilidad (git rev-parse HEAD)
GIT_COMMIT=
